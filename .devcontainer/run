#!/usr/bin/env python3
"""Run one command in the sandbox container: `.devcontainer/run make check` (CHB-31).

Third-party code (npm and PyPI packages, test runners, linters) runs here, not on the host.
The container holds no secret: no host environment variable, no keyring, no 1Password.
Its outbound network is limited to .devcontainer/allowed-hosts.txt (init-firewall.sh).

- The checkout is mounted at its own host path, so a git worktree's `.git` file resolves.
- The checkout and the git folder are read-only; only backend/ and frontend/ are writable.
  The container cannot change a git hook, a Claude Code hook, a script or the Makefile that
  the host runs later.
- frontend/node_modules is a Docker volume per checkout, apart from the host folder.
- The image tag is a hash of the image files: a changed allow list builds a new image.
- An existing backend/.venv is hidden behind an empty tmpfs.
- After the command, a `.git` entry in backend/ or frontend/, or a new backend/.venv, stops
  with exit code 3.
Exit code: the command's, 3 for a stray `.git`, or 125 to 127 from Docker.
"""

from __future__ import annotations

import hashlib
import os
import subprocess
import sys
from pathlib import Path

HERE = Path(__file__).resolve().parent
IMAGE_FILES = ("Dockerfile", "allowed-hosts.txt", "egress.py", "init-firewall.sh", "entry.sh")
CACHE_VOLUME = "chb-sandbox-cache"
# The only folders the container may write. Everything else, including the hooks the host runs
# (factory/, scripts/, .claude/, .devcontainer/, Makefile), is read-only.
WRITABLE = ("backend", "frontend")
# Host folders inside a writable folder that the host runs code from. The container sees an
# empty tmpfs there; if one did not exist, its appearance after the run stops the launcher.
HOST_ONLY = ("backend/.venv",)


def image_tag(context: Path = HERE) -> str:
    digest = hashlib.sha256()
    for name in IMAGE_FILES:
        digest.update(name.encode() + b"\0" + (context / name).read_bytes() + b"\0")
    return f"chb-sandbox:{digest.hexdigest()[:16]}"


def node_modules_volume(top: str) -> str:
    return f"chb-sandbox-nm-{hashlib.sha256(top.encode()).hexdigest()[:12]}"


def docker_args(
    top: str, git_common_dir: str, image: str, command: list[str], *, tty: bool, hidden: list[str] | tuple[str, ...] = ()
) -> list[str]:
    args = ["docker", "run", "--rm", "-i"]
    if tty:
        args.append("-t")
    args += ["--cap-add", "NET_ADMIN", "--cap-add", "NET_RAW"]
    args += [
        "--mount", f"type=bind,source={top},target={top},readonly",
        "--mount", f"type=bind,source={git_common_dir},target={git_common_dir},readonly",
        *[a for d in WRITABLE for a in ("--mount", f"type=bind,source={top}/{d},target={top}/{d}")],
        "--mount", f"type=volume,source={node_modules_volume(top)},target={top}/frontend/node_modules",
        "--mount", f"type=volume,source={CACHE_VOLUME},target=/home/agent/.cache",
        *[a for d in hidden for a in ("--mount", f"type=tmpfs,target={top}/{d}")],
        "--workdir", top,
        image,
        *command,
    ]
    return args


def stray_git_entries(top: str) -> list[str]:
    """`.git` folders or files in the writable folders. Git on the host, started inside one,
    would load that repository's config, which can run commands (core.fsmonitor, hooks).
    frontend/node_modules is skipped: the container sees its own volume there, not this folder."""
    found = []
    for folder in WRITABLE:
        for root, dirs, files in os.walk(Path(top) / folder):
            if root == str(Path(top) / "frontend"):
                dirs[:] = [d for d in dirs if d != "node_modules"]
            if ".git" in dirs or ".git" in files:
                found.append(os.path.join(root, ".git"))
            dirs[:] = [d for d in dirs if d != ".git"]
    return found


def new_host_paths(top: str, existed: set[str]) -> list[str]:
    """HOST_ONLY folders that exist now but did not before the run: the container made them."""
    return [str(Path(top) / d) for d in HOST_ONLY if d not in existed and (Path(top) / d).exists()]


def prepare(top: str) -> None:
    """Make the mount point of the node_modules volume as the user: Docker would make it as root."""
    (Path(top) / "frontend" / "node_modules").mkdir(exist_ok=True)


def _git(*args: str) -> str:
    return subprocess.run(["git", *args], capture_output=True, text=True, check=True).stdout.strip()


def _ensure_image(tag: str) -> None:
    present = subprocess.run(["docker", "image", "inspect", tag], capture_output=True, check=False)
    if present.returncode != 0:
        print(f"run: building {tag} (first run after a change of .devcontainer/)", file=sys.stderr)
        subprocess.run(["docker", "build", "-q", "-t", tag, str(HERE)], check=True, stdout=subprocess.DEVNULL)


def main(argv: list[str]) -> int:
    if not argv:
        print("usage: .devcontainer/run <command> [args...]   for example: .devcontainer/run make check", file=sys.stderr)
        return 2
    top = _git("rev-parse", "--show-toplevel")
    common = str(Path(_git("rev-parse", "--path-format=absolute", "--git-common-dir")))
    tag = image_tag()
    try:
        _ensure_image(tag)
    except subprocess.CalledProcessError as error:
        print(f"run: docker build failed ({error.returncode})", file=sys.stderr)
        return 125
    prepare(top)
    existed = {d for d in HOST_ONLY if (Path(top) / d).exists()}
    tty = sys.stdin.isatty() and sys.stdout.isatty()
    args = docker_args(top, common, tag, argv, tty=tty, hidden=sorted(existed))
    code = subprocess.run(args, check=False).returncode
    stray = stray_git_entries(top) + new_host_paths(top, existed)
    if stray:
        print("run: STOP. The container made a git repository or a Python environment in a", file=sys.stderr)
        print("run: folder it can write. The host could run code from it: do not use it.", file=sys.stderr)
        print("run: The owner checks and removes:", file=sys.stderr)
        for path in stray:
            print(f"run:   {path}", file=sys.stderr)
        return 3
    return code


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
