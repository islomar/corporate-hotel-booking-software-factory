#!/usr/bin/env bash
# Repo pre-commit gate: the full check suite, in the sandbox container (CHB-31). Installed by `make setup`.
# Third-party code (npm and PyPI packages) runs in the container, not on the host: README.md, "Sandbox container".
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"
exec .devcontainer/run make --no-print-directory check
