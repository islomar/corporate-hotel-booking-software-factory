# Resolve only versions published at least 7 days ago (npm >= 11.10).
# The value is a number of days: "7d" is invalid. `npm ci` ignores it, so CI checks
# lockfile changes with scripts/check-release-age.py. To let a fresh security fix in,
# add a `min-release-age-exclude[]=<name>` line with a comment that says when to remove it.
min-release-age=7
